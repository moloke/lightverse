# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Zoho Mail SMTP Configuration (for support ticket notifications)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=support@lightverse.org
SMTP_PASSWORD=your_zoho_password_or_app_specific_password
SMTP_FROM=LightVerse Support <support@lightverse.org>
SUPPORT_NOTIFICATION_EMAIL=admin@lightverse.org

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
